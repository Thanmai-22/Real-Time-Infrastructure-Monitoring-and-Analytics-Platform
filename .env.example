# Copy this file to .env and adjust values for local development

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_METRICS=infrastructure.metrics
KAFKA_TOPIC_ANOMALIES=infrastructure.anomalies
KAFKA_CONSUMER_GROUP=infra-processor

# Database (TimescaleDB / PostgreSQL)
DATABASE_URL=postgresql+psycopg2://monitor:monitor_secret@localhost:5432/infra_monitor

# Event Generator
EMIT_INTERVAL_SECONDS=1

# Anomaly Detection thresholds
ANOMALY_CPU_THRESHOLD=85.0
ANOMALY_MEMORY_THRESHOLD=90.0
ANOMALY_LATENCY_THRESHOLD=2000.0
ANOMALY_ERROR_RATE_THRESHOLD=15.0
ANOMALY_ZSCORE_WINDOW=60
ANOMALY_ZSCORE_THRESHOLD=3.0
